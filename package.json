{
  "name": "carvinguard",
  "version": "1.0.0",
  "description": "Rapport historique véhicule par numéro VIN (Carvinguard)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "serve": "cd public && python3 -m http.server 3000",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "blog": "node scripts/generate-blog.js",
    "blog:publish": "node scripts/publish-next-blog.js",
    "db:push": "prisma db push",
    "db:seed": "node scripts/seed-blog-db.js",
    "gen:jwt-secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "saas:check": "node scripts/check-saas-ready.js",
    "saas:check:prod": "node scripts/check-saas-ready.js --prod",
    "stripe:setup": "node scripts/stripe-create-catalog.js",
    "stripe:tout": "node scripts/stripe-tout-en-un.js",
    "verify": "node scripts/verify-deploy.js",
    "deploy:check": "node scripts/verify-deploy.js",
    "deploy:vercel": "vercel --prod"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.1",
    "pdfkit": "^0.17.2",
    "resend": "^6.9.2",
    "stripe": "^20.3.1"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  }
}
