# Copier ce fichier en .env et remplir les valeurs

# Stripe - OBLIGATOIRE pour les paiements
STRIPE_PUBLISHABLE_KEY=pk_xxx
STRIPE_SECRET_KEY=sk_xxx

# Webhook Stripe - pour enregistrer les commandes (optionnel)
# Créer un webhook sur dashboard.stripe.com → Developers → Webhooks
# URL: https://votredomaine.com/api/stripe-webhook
# Événement: payment_intent.succeeded
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Pour envoyer les commandes vers Google Sheets (optionnel)
# Voir COMMANDES.md pour configurer
ORDERS_WEBHOOK_URL=

# Email équipe : envoi automatique à chaque paiement validé
# Destinataire (défaut: infos.vosdocs@gmail.com)
MAIL_TO=infos.vosdocs@gmail.com
# Optionnel : expéditeur affiché (défaut: SMTP_USER)
# MAIL_FROM= VosDocs <infos.vosdocs@gmail.com>

# SMTP Gmail : créer un "Mot de passe d'application" sur compte Google
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=infos.vosdocs@gmail.com
SMTP_PASS=votre_mot_de_passe_application
# En production (Vercel) : définir ces variables dans Settings → Environment Variables.
