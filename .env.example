# Remplis puis : npm run saas:check:prod  |  Code OK sans secrets : npm run verify  |  Stripe auto : npm run stripe:tout
#
# ----- Stripe -----
# Prod : sk_live_… + pk_live_… + webhook Live (whsec_…) sur l’URL FINALE sans redirection, ex. :
# https://www.carvinguard.fr/api/stripe-webhook
# (Si tu mets carvinguard.com et que ça redirige en 307 vers www, Stripe échoue — voir npm run verify:webhook)
# Test : sk_test_… + pk_test_… — npm run stripe:setup puis npm run saas:check:prod avant mise en prod
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secret « Signing » du endpoint dans Stripe (whsec_…) — le même que la destination pointant vers
# l’URL finale https://www.carvinguard.fr/api/stripe-webhook (mode Test ou Live, selon la clé sk_test/sk_live).
# Dans Stripe le webhook doit surtout recevoir (mode correspondant à la clé) :
#   - checkout.session.completed  ← obligatoire pour les crédits via /api/billing/credit-checkout
#   - payment_intent.succeeded
#   - invoice.paid (ou invoice.payment_succeeded) pour l’abonnement
# Si le dashboard affiche « 0 » événements, vérifier : même compte que la clé, même mode (test/live), types d’événements, puis : npm run stripe:diag-webhooks
STRIPE_WEBHOOK_SECRET=
# Liens Payment Links (npm run stripe:setup — BASE_URL utilisé pour redirection /confirmation.html)
# Chaque lien doit rediriger après paiement vers une URL avec {CHECKOUT_SESSION_ID}, ex. :
# https://www.carvinguard.fr/confirmation.html?session_id={CHECKOUT_SESSION_ID}
# (sinon Stripe renvoie à la racine / et rien ne se passe — npm run stripe:setup recrée des liens corrects)
STRIPE_PAYMENT_LINK_ESSENTIEL=
STRIPE_PAYMENT_LINK_CONFORT=
STRIPE_PAYMENT_LINK_PREMIUM=

# ----- Email (commandes + activation espace client après paiement sans compte) -----
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
MAIL_TO=contact@carvingard.fr

# ----- Auto-Blog SEO -----
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
GROQ_API_KEY=
CRON_SECRET=
MERCHANT_EMAIL=contact@carvingard.fr
# Réponse « Reply-To » des emails de validation d’articles (défaut : même adresse que MERCHANT_EMAIL)
# MERCHANT_REPLY_TO=contact@carvingard.fr
# Nom affiché dans les sujets/emails blog (défaut dans le code : Carvingard)
SITE_BRAND=Carvingard
BASE_URL=https://www.carvingard.fr
# URL publique du site (liens dans les emails client : « Voir mon rapport »). Par défaut : VERCEL_URL en prod.
APP_ORIGIN=https://www.carvingard.fr

# ----- Décodage VIN -----
# Vehicle Databases (portail : https://vehicledatabases.com/portal) — utilisé en priorité si la clé est définie.
VEHICLEDATABASES_API_KEY=
# Optionnel : forcer le fournisseur si plusieurs clés sont présentes : vehicledatabases | carapi
# VIN_DECODE_PROVIDER=vehicledatabases
#
# CarAPI.dev (secondaire / legacy) : https://api.carapi.dev/openapi.json
# Si vous ne voulez que Vehicle Databases, laissez CARAPI_TOKEN vide et définissez seulement VEHICLEDATABASES_API_KEY.
CARAPI_TOKEN=
# CARAPI_API_KEY=

# ----- SaaS (comptes + crédits VIN) -----
# Obligatoire pour inscription / connexion (génère-en un : npm run gen:jwt-secret)
JWT_SECRET=
# Crédits offerts à l’inscription (désactivée côté API — laisser 0)
WELCOME_CREDITS=0
# Paliers compte connecté = mêmes montants que la page Tarifs / Payment Links (centimes)
TIER_ESSENTIEL_CENTS=1499
TIER_CONFORT_CENTS=2999
TIER_PREMIUM_CENTS=6999
# Optionnel — surcharge uniquement : le serveur détecte les price_… dans Stripe (montants + noms produits).
TIER_ESSENTIEL_PRICE_ID=
TIER_CONFORT_PRICE_ID=
TIER_PREMIUM_PRICE_ID=

# Abonnement (optionnel si les prix existent déjà sur Stripe : ~1€ ponctuel + ~49,99€/mois — détection auto sinon)
SUBSCRIPTION_PRICE_INITIAL_ID=
SUBSCRIPTION_PRICE_MONTHLY_ID=
SUBSCRIPTION_CREDITS_PER_CYCLE=7
SUBSCRIPTION_TRIAL_DAYS=1
SUBSCRIPTION_INITIAL_CENTS_FOR_DISPLAY=100
SUBSCRIPTION_MONTHLY_CENTS_FOR_DISPLAY=4999

# ----- Optionnel -----
ORDERS_WEBHOOK_URL=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
SMTP_SECURE=false
