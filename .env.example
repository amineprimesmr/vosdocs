# Copier ce fichier en .env et remplir les valeurs

# Stripe - OBLIGATOIRE pour les paiements
STRIPE_PUBLISHABLE_KEY=pk_xxx
STRIPE_SECRET_KEY=sk_xxx

# Webhook Stripe - pour enregistrer les commandes (optionnel)
# Créer un webhook sur dashboard.stripe.com → Developers → Webhooks
# URL: https://votredomaine.com/api/stripe-webhook
# Événement: payment_intent.succeeded
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Pour envoyer les commandes vers Google Sheets (optionnel)
# Voir COMMANDES.md pour configurer
ORDERS_WEBHOOK_URL=
